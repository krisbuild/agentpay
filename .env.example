# Gemini Developer API key (AIza...) or Vertex AI express-mode key (AQ...)
GEMINI_API_KEY=
# Optional: send requests to Vertex AI instead of the Gemini API
# GEMINI_USE_VERTEXAI=true
# Optional: override the Gemini model
GEMINI_MODEL=gemini-3.8-flash
# Optional: comma-separated models to fall back to when the main one is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live" — keep sandbox until you've tested end to end
PAYPAL_ENV=sandbox
# Password for /admin (web app)
ADMIN_PASSWORD=
BOUNTY_DB_PATH=data/db.json
