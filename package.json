{
  "name": "agentpay",
  "version": "1.0.0",
  "description": "AI agent that reviews bounty submissions and proposes PayPal payouts for human approval",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "agent": "tsx --env-file-if-exists=.env src/cli.ts agent",
    "approve": "tsx --env-file-if-exists=.env src/cli.ts approve"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
