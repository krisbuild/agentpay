{
  "name": "gentpay",
  "version": "1.0.0",
  "description": "AI agent that reviews bounty submissions and proposes PayPal payouts for human approval",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "agent": "tsx --env-file-if-exists=.env src/cli.ts agent",
    "approve": "tsx --env-file-if-exists=.env src/cli.ts approve"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^3.1.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
